<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

	<targets>
		<target name="logfile" xsi:type="File"
                fileName="${basedir}/logs/${shortdate}_logfile.txt"
                archiveFileName="${basedir}/logs/archives/log.{#}.txt"
                archiveEvery="Day"
                archiveNumbering="Rolling"
                maxArchiveFiles="7"
                archiveAboveSize="10485760"
                layout="${longdate} | ${level:uppercase=true} | ${when:when=level==LogLevel.Info:inner=[ACTION]:else=[EXCEPTION]} | ${message} ${exception:format=tostring}"/>

		<target name="logconsole" xsi:type="ColoredConsole"
                layout="${longdate} | ${level:uppercase=true} | ${when:when=level==LogLevel.Info:inner=[ACTION]:else=[EXCEPTION]} | ${message} ${exception:format=tostring}"/>
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="logfile" />

		<logger name="*" minlevel="Warn" writeTo="logconsole" />
	</rules>
</nlog>